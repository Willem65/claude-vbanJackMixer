   <input node="USB Audio Pro 2" port="USB Audio #2:playback_AUX0"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="jack_mixer" port="jack_mixer:Fx-USB2 Out R"/>
   <input node="USB Audio Pro 2" port="USB Audio #2:playback_AUX1"/>
  </item>
 </items>
</patchbay>

