  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="jack_mixer" port="jack_mixer:Fx-vban Out R"/>
   <input node="vban-zender" port="vban-zender:input_FR"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="jack_mixer" port="jack_mixer:Fx-USB2 Out L"/>
