  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="jack_mixer" port="jack_mixer:Fx-vban Out L"/>
   <input node="vban-zender" port="vban-zender:input_FL"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="Firefox" port="Firefox:output_FR"/>
   <input node="jack_mixer" port="jack_mixer:Fx-vban R"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="Firefox" port="Firefox:output_FL"/>
   <input node="jack_mixer" port="jack_mixer:Fx-vban L"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="vban-ontvanger" port="vban-ontvanger:playback_1"/>
   <input node="jack_mixer" port="jack_mixer:vban-USB2 L"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
