<!DOCTYPE patchbay>
<patchbay version="0.6.1" name="mixer">
 <items>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="Firefox" port="Firefox:output_FL"/>
   <input node="jack_mixer" port="jack_mixer:Fx-USB2 L"/>
  </item>
  <item port-type="pipewire-audio" node-type="pipewire">
   <output node="Firefox" port="Firefox:output_FR"/>
   <input node="jack_mixer" port="jack_mixer:Fx-USB2 R"/>
